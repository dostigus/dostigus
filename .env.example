# Cluster Store (SQLite). Compose sets file:/var/lib/dostigus/cluster.sqlite
DATABASE_URL=file:.data/cluster.sqlite

# Optional LLM gateway (OpenAI-compatible chat completions).
# Env overrides Host Settings (Store). Chat works without a key — replies
# are stubs and the Host shows a banner. Greeting is still stored.
# A key with no base URL uses https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# OPENROUTER_API_KEY=
# LLM_MODEL=openai/gpt-4o
# LLM_MODEL_CHEAP=openai/gpt-4o-mini
# LLM_MODEL_STRONG=openai/gpt-4o
# LLM_MODEL_CODE=openai/gpt-4o
# LLM_MODEL_TOY=openai/gpt-4o-mini
# LLM_DEFAULT_TIER=strong

# Sealed Host Owner session (≥32 chars). Required in production.
# Local `pnpm dev` generates one if unset. Compose should set this.
# NUXT_SESSION_PASSWORD=

# MCP surface Bearer for /mcp (empty → tools stay disabled).
# Separate from the Owner session — do not reuse NUXT_SESSION_PASSWORD.
# NUXT_AGENT_TOKEN=
# DOSTIGUS_MCP_TOKEN=
