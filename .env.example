# Cluster Store (SQLite). Compose sets file:/var/lib/dostigus/cluster.sqlite
DATABASE_URL=file:.data/cluster.sqlite

# Optional LLM gateway (OpenAI-compatible chat completions).
# Host Chat works without these — replies are stubs, greeting is still stored.
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# OPENROUTER_API_KEY=
# LLM_MODEL=openai/gpt-4o
